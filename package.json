{
  "name": "@biosimulant/model-compatibility-standard",
  "version": "0.0.1",
  "description": "Schemas, profiles, and Python/TypeScript reference validators for the Biosimulant Model Compatibility Standard",
  "keywords": [
    "biosimulant",
    "biology",
    "simulation",
    "interoperability",
    "json-schema"
  ],
  "author": "Biosimulant",
  "homepage": "https://github.com/Biosimulant/model-compatibility-standard#readme",
  "bugs": {
    "url": "https://github.com/Biosimulant/model-compatibility-standard/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Biosimulant/model-compatibility-standard.git"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./typescript/dist/index.js",
  "types": "./typescript/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./typescript/dist/index.d.ts",
      "import": "./typescript/dist/index.js"
    },
    "./browser": {
      "types": "./typescript/dist/browser.d.ts",
      "import": "./typescript/dist/browser.js"
    },
    "./spec/*": "./spec/*"
  },
  "files": [
    "typescript/dist",
    "spec/v0.1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:spec": "python3 scripts/build_standard.py --check",
    "build:browser-data": "node scripts/build_browser_data.mjs",
    "build": "npm run build:spec && npm run build:browser-data && tsc -p typescript/tsconfig.json",
    "test": "npm run build && node --test typescript/test/*.test.mjs && node scripts/check_cross_language.mjs",
    "test:scientific": "npm run build && python3 -m pytest python/tests/test_scientific_checks.py && node --test typescript/test/scientific-checks.test.mjs",
    "prepack": "npm test",
    "prepare": "npm run build:browser-data && tsc -p typescript/tsconfig.json"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^2.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
