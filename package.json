{
  "name": "@biosimulant/model-compatibility-standard",
  "version": "0.1.0-alpha.1",
  "description": "Schemas, profiles, fixtures, and reference validation for the BioSimulant Model Compatibility Standard",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "main": "./typescript/dist/index.js",
  "types": "./typescript/dist/index.d.ts",
  "files": [
    "typescript/dist",
    "spec/v0.1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:spec": "python3 scripts/build_standard.py --check",
    "build": "npm run build:spec && tsc -p typescript/tsconfig.json",
    "test": "npm run build && node --test typescript/test/*.test.mjs",
    "prepack": "npm test"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^2.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
