{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biosimulant.com/standards/model-compatibility/source/profile-review.schema.json",
  "title": "Biosimulant compatibility profile review evidence",
  "type": "object",
  "required": [
    "profile_id",
    "authors",
    "scientific_reviewer",
    "schema_reviewer",
    "domain_owner",
    "reviewed_at",
    "sources",
    "intended_use",
    "limitations",
    "decisions",
    "fixture_review"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+@0\\.1$"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "scientific_reviewer": { "type": "string", "minLength": 2 },
    "schema_reviewer": { "type": "string", "minLength": 2 },
    "domain_owner": { "type": "string", "minLength": 2 },
    "reviewed_at": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
          "required": ["id", "title", "kind", "url", "version", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "title": { "type": "string", "minLength": 5 },
          "kind": {
            "enum": [
              "primary-publication",
              "standard",
              "ontology",
              "database",
              "regulatory-guidance",
              "other-authoritative"
            ]
          },
          "url": { "type": "string", "format": "uri" },
          "version": { "type": "string" },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "intended_use": { "type": "string", "minLength": 20 },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 10 }
    },
    "decisions": {
      "type": "object",
      "properties": {
        "structure": { "$ref": "#/$defs/decision" },
        "semantic": { "$ref": "#/$defs/decision" },
        "representation": { "$ref": "#/$defs/decision" },
        "dimensions": { "$ref": "#/$defs/decision" },
        "identifiers": { "$ref": "#/$defs/decision" },
        "measurement": { "$ref": "#/$defs/decision" },
        "biological_context": { "$ref": "#/$defs/decision" },
        "lifecycle": { "$ref": "#/$defs/decision" },
        "origin": { "$ref": "#/$defs/decision" },
        "uncertainty": { "$ref": "#/$defs/decision" },
        "artifact": { "$ref": "#/$defs/decision" },
        "constraints": { "$ref": "#/$defs/decision" },
        "security": { "$ref": "#/$defs/decision" }
      },
      "required": [
        "structure",
        "semantic",
        "representation",
        "dimensions",
        "identifiers",
        "measurement",
        "biological_context",
        "lifecycle",
        "origin",
        "uncertainty",
        "artifact",
        "constraints",
        "security"
      ],
      "additionalProperties": false
    },
    "fixture_review": {
      "type": "object",
      "required": ["positive", "negative", "invalid", "direct", "incompatible", "unknown", "transformations"],
      "properties": {
        "positive": { "$ref": "#/$defs/fixtureNames" },
        "negative": { "$ref": "#/$defs/fixtureNames" },
        "invalid": { "$ref": "#/$defs/fixtureNames" },
        "direct": { "$ref": "#/$defs/fixtureNames" },
        "incompatible": { "$ref": "#/$defs/fixtureNames" },
        "unknown": { "$ref": "#/$defs/fixtureNames" },
        "transformations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["disposition", "rationale", "field_paths", "source_ids"],
      "properties": {
        "disposition": { "enum": ["included", "conditional", "excluded"] },
        "rationale": { "type": "string", "minLength": 20 },
        "field_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        }
      },
      "additionalProperties": false
    },
    "fixtureNames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
