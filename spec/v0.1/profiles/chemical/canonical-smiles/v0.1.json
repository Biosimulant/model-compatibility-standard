{
  "$id": "https://biosimulant.com/standards/model-compatibility/profiles/chemical/canonical-smiles/v0.1",
  "$schema": "https://biosimulant.com/standards/model-compatibility/v0.1/schemas/profile-definition.schema.json",
  "allowed": {
    "representation": {
      "kind": [
        "scalar",
        "record",
        "table",
        "artifact",
        "file"
      ]
    }
  },
  "applies_to": [
    "scalar",
    "record",
    "artifact"
  ],
  "comparison_rules": [
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_SEMANTIC_CONCEPT_MISMATCH",
      "severity": "error",
      "source": "/contract/semantic/concept",
      "target": "/contract/semantic/concept"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "representation-equivalent",
      "reason_code": "BMCS_REPRESENTATION_KIND_MISMATCH",
      "severity": "error",
      "source": "/contract/representation",
      "target": "/contract/representation"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_CANONICALIZATION_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/canonicalization",
      "target": "/contract/representation/canonicalization"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_NORMALIZATION_TOOL_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/normalization_tool",
      "target": "/contract/representation/normalization_tool"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_NORMALIZATION_VERSION_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/normalization_version",
      "target": "/contract/representation/normalization_version"
    }
  ],
  "compatibility_notes": "Two ports match only when every field the target requires is satisfied. Missing required information returns UNKNOWN. Every conversion or inference must be declared and versioned.",
  "description": "A SMILES representation designated canonical by a declared canonicalization method, software implementation and version for a specified chemical structure.\n",
  "domain": "chemical",
  "domain_label": "Chemical identity and representation",
  "examples": [
    {
      "check": "compare",
      "conditions": "Both ports declare different methods and no normalising adapter is supplied.",
      "decision": "V0 canonical-SMILES profile",
      "expect": {
        "status": "INCOMPATIBLE"
      },
      "id": "BMCS-V0-004",
      "report_finding": "Contradictory canonicalization provenance",
      "source_patch": {
        "representation": {
          "canonicalization": "method-a"
        }
      },
      "target_patch": {
        "representation": {
          "canonicalization": "method-b"
        }
      },
      "title": "Different canonicalization methods are incompatible",
      "why": "Canonical SMILES is method-dependent, so different declared methods cannot be assumed identical."
    },
    {
      "check": "compare",
      "conditions": "The source omits the tool version required by the target contract.",
      "decision": "V0 canonical-SMILES profile",
      "expect": {
        "status": "UNKNOWN"
      },
      "id": "BMCS-V0-005",
      "report_finding": "Missing canonicalization provenance",
      "source_remove": [
        "representation.normalization_version"
      ],
      "title": "Missing canonicalization tool version is unknown",
      "why": "The same tool can change canonical output between versions."
    },
    {
      "check": "compare",
      "conditions": "Both ports make the same complete declarations for this profile.",
      "decision": "V0 canonical-SMILES profile",
      "expect": {
        "status": "EXACT"
      },
      "id": "BMCS-V0-008",
      "report_finding": "Positive baseline",
      "title": "Identical canonical-SMILES contracts are exact matches",
      "why": "The same complete canonical-SMILES declaration can connect without conversion or approval."
    }
  ],
  "extends": [],
  "field_dispositions": {
    "identifiers.structure_hash": {
      "disposition": "recommended"
    },
    "origin.software": {
      "disposition": "excluded"
    },
    "origin.software_version": {
      "disposition": "excluded"
    },
    "origin.source_ref": {
      "disposition": "recommended"
    },
    "origin.source_sha256": {
      "disposition": "recommended"
    },
    "representation.canonicalization": {
      "disposition": "required"
    },
    "representation.formal_charge": {
      "disposition": "recommended"
    },
    "representation.isotope_state": {
      "disposition": "recommended"
    },
    "representation.kind": {
      "disposition": "required"
    },
    "representation.normalization_tool": {
      "disposition": "required"
    },
    "representation.normalization_version": {
      "disposition": "required"
    },
    "representation.protonation_state": {
      "disposition": "recommended"
    },
    "representation.stereochemistry": {
      "disposition": "recommended"
    },
    "representation.tautomer_state": {
      "disposition": "recommended"
    },
    "semantic.concept": {
      "disposition": "required"
    },
    "semantic.ontology_terms": {
      "disposition": "excluded"
    },
    "semantic.qualifiers": {
      "disposition": "excluded"
    }
  },
  "fixed": {
    "semantic": {
      "concept": "https://biosimulant.com/standards/model-compatibility/terms/chemical/canonical-smiles"
    }
  },
  "intended_use": "Connecting a model output that provides canonical SMILES to a model input that expects the same declared canonicalization method and software version.\n",
  "label": "Canonical SMILES",
  "limitations": [
    "It does not establish that two differently normalised strings represent the same chemical entity.",
    "It does not silently resolve stereochemistry, protonation, tautomer, isotope or charge choices."
  ],
  "name": "canonical-smiles",
  "profile_id": "chemical/canonical-smiles@0.1",
  "requirements": [
    {
      "level": "required",
      "path": "semantic.concept",
      "schema": {
        "const": "https://biosimulant.com/standards/model-compatibility/terms/chemical/canonical-smiles"
      }
    },
    {
      "level": "required",
      "path": "representation.kind",
      "schema": {
        "enum": [
          "scalar",
          "record",
          "table",
          "artifact",
          "file"
        ]
      }
    },
    {
      "level": "required",
      "path": "representation.canonicalization",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "representation.normalization_tool",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "representation.normalization_version",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "recommended",
      "path": "identifiers.structure_hash",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "recommended",
      "path": "representation.stereochemistry",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "recommended",
      "path": "representation.protonation_state",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "recommended",
      "path": "representation.tautomer_state",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "recommended",
      "path": "representation.formal_charge",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "recommended",
      "path": "representation.isotope_state",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "recommended",
      "path": "origin.source_ref",
      "schema": {
        "format": "uri",
        "type": "string"
      }
    },
    {
      "level": "recommended",
      "path": "origin.source_sha256",
      "schema": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      }
    }
  ],
  "scientific_claim": "This profile checks whether two model interfaces fit together. It does not show that a model is scientifically valid or clinically safe.",
  "sources": [
    {
      "title": "SMILES, a Chemical Language and Information System. 1. Introduction to Methodology and Encoding Rules",
      "url": "https://doi.org/10.1021/ci00057a005"
    },
    {
      "title": "OpenSMILES specification",
      "url": "https://opensmiles.org/opensmiles.html"
    }
  ],
  "status": "active",
  "transformation_policy": {
    "inference": "approval",
    "lossless": "allow",
    "lossy": "approval"
  },
  "version": "0.1.0"
}
