{
  "$id": "https://biosimulant.com/standards/model-compatibility/profiles/core/tensor/v0.1",
  "$schema": "https://biosimulant.com/standards/model-compatibility/v0.1/schemas/profile-definition.schema.json",
  "allowed": {
    "representation": {
      "kind": [
        "scalar",
        "dense_vector",
        "sparse_vector",
        "matrix",
        "tensor",
        "array",
        "record",
        "table"
      ]
    }
  },
  "applies_to": [
    "scalar",
    "array",
    "record"
  ],
  "comparison_rules": [
    {
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_SEMANTIC_CONCEPT_MISMATCH",
      "severity": "error",
      "source": "/contract/semantic/concept",
      "target": "/contract/semantic/concept"
    },
    {
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_KIND_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/kind",
      "target": "/contract/representation/kind"
    },
    {
      "missing": "unknown",
      "operator": "labels-equal",
      "reason_code": "BMCS_DIMENSIONS_AXES_MISMATCH",
      "severity": "error",
      "source": "/contract/dimensions/axes",
      "target": "/contract/dimensions/axes"
    },
    {
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_ORDERING_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/ordering",
      "target": "/contract/representation/ordering"
    },
    {
      "missing": "ignore",
      "operator": "unit-convertible",
      "reason_code": "BMCS_MEASUREMENT_UNIT_MISMATCH",
      "severity": "error",
      "source": "/contract/measurement/unit",
      "target": "/contract/measurement/unit"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_MEASUREMENT_SCALE_MISMATCH",
      "severity": "error",
      "source": "/contract/measurement/scale",
      "target": "/contract/measurement/scale"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_MEASUREMENT_TRANSFORM_MISMATCH",
      "severity": "error",
      "source": "/contract/measurement/transform",
      "target": "/contract/measurement/transform"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_MEASUREMENT_QUANTITY_MISMATCH",
      "severity": "error",
      "source": "/contract/measurement/quantity",
      "target": "/contract/measurement/quantity"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_MEASUREMENT_NORMALIZATION_MISMATCH",
      "severity": "error",
      "source": "/contract/measurement/normalization",
      "target": "/contract/measurement/normalization"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_MEASUREMENT_BASELINE_MISMATCH",
      "severity": "error",
      "source": "/contract/measurement/baseline",
      "target": "/contract/measurement/baseline"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_MEASUREMENT_AGGREGATION_MISMATCH",
      "severity": "error",
      "source": "/contract/measurement/aggregation",
      "target": "/contract/measurement/aggregation"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_IDENTIFIERS_NAMESPACE_MISMATCH",
      "severity": "error",
      "source": "/contract/identifiers/namespace",
      "target": "/contract/identifiers/namespace"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_IDENTIFIERS_NAMESPACE_VERSION_MISMATCH",
      "severity": "error",
      "source": "/contract/identifiers/namespace_version",
      "target": "/contract/identifiers/namespace_version"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_FEATURE_SPACE_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/feature_space",
      "target": "/contract/representation/feature_space"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_REFERENCE_ASSEMBLY_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/reference_assembly",
      "target": "/contract/representation/reference_assembly"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_COORDINATE_SYSTEM_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/coordinate_system",
      "target": "/contract/representation/coordinate_system"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_LIFECYCLE_TIME_UNIT_MISMATCH",
