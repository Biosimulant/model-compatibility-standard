        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "measurement.scale",
      "schema": {
        "enum": [
          "nominal",
          "ordinal",
          "interval",
          "ratio",
          "proportion",
          "probability",
          "count"
        ]
      }
    },
    {
      "level": "required",
      "path": "biological_context.species",
      "schema": {
        "anyOf": [
          {
            "const": "any"
          },
          {
            "pattern": "^NCBITaxon:[1-9][0-9]*$"
          }
        ],
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "security.data_use",
      "schema": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      }
    },
    {
      "level": "required",
      "path": "security.consent_scope",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "measurement.rate_basis",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
