{
  "$id": "https://biosimulant.com/standards/model-compatibility/profiles/imaging/probability-map/v0.1",
  "$schema": "https://biosimulant.com/standards/model-compatibility/v0.1/schemas/profile-definition.schema.json",
  "allowed": {
    "representation": {
      "kind": [
        "dense_vector",
        "sparse_vector",
        "matrix",
        "tensor",
        "array",
        "artifact",
        "file",
        "record",
        "table"
      ]
    }
  },
  "applies_to": [
    "array",
    "artifact",
    "record"
  ],
  "comparison_rules": [
    {
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_SEMANTIC_CONCEPT_MISMATCH",
      "severity": "error",
      "source": "/contract/semantic/concept",
      "target": "/contract/semantic/concept"
    },
    {
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_KIND_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/kind",
      "target": "/contract/representation/kind"
    },
    {
      "missing": "unknown",
      "operator": "labels-equal",
      "reason_code": "BMCS_DIMENSIONS_AXES_MISMATCH",
      "severity": "error",
      "source": "/contract/dimensions/axes",
      "target": "/contract/dimensions/axes"
    },
    {
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_ORDERING_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/ordering",
      "target": "/contract/representation/ordering"
    },
    {
      "missing": "unknown",
      "operator": "context-compatible",
      "reason_code": "BMCS_BIOLOGICAL_CONTEXT_SPECIES_MISMATCH",
      "severity": "error",
      "source": "/contract/biological_context/species",
      "target": "/contract/biological_context/species"
    },
    {
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_DIMENSIONS_PIXEL_SPACING_MISMATCH",
      "severity": "error",
      "source": "/contract/dimensions/pixel_spacing",
      "target": "/contract/dimensions/pixel_spacing"
    },
    {
      "missing": "ignore",
      "operator": "unit-convertible",
      "reason_code": "BMCS_MEASUREMENT_UNIT_MISMATCH",
      "severity": "error",
      "source": "/contract/measurement/unit",
      "target": "/contract/measurement/unit"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_MEASUREMENT_SCALE_MISMATCH",
      "severity": "error",
      "source": "/contract/measurement/scale",
      "target": "/contract/measurement/scale"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_MEASUREMENT_TRANSFORM_MISMATCH",
      "severity": "error",
      "source": "/contract/measurement/transform",
      "target": "/contract/measurement/transform"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_MEASUREMENT_QUANTITY_MISMATCH",
      "severity": "error",
      "source": "/contract/measurement/quantity",
      "target": "/contract/measurement/quantity"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_MEASUREMENT_NORMALIZATION_MISMATCH",
      "severity": "error",
      "source": "/contract/measurement/normalization",
      "target": "/contract/measurement/normalization"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_MEASUREMENT_BASELINE_MISMATCH",
      "severity": "error",
      "source": "/contract/measurement/baseline",
      "target": "/contract/measurement/baseline"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_MEASUREMENT_AGGREGATION_MISMATCH",
      "severity": "error",
      "source": "/contract/measurement/aggregation",
      "target": "/contract/measurement/aggregation"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_IDENTIFIERS_NAMESPACE_MISMATCH",
      "severity": "error",
      "source": "/contract/identifiers/namespace",
      "target": "/contract/identifiers/namespace"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_IDENTIFIERS_NAMESPACE_VERSION_MISMATCH",
      "severity": "error",
      "source": "/contract/identifiers/namespace_version",
      "target": "/contract/identifiers/namespace_version"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_FEATURE_SPACE_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/feature_space",
      "target": "/contract/representation/feature_space"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_REFERENCE_ASSEMBLY_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/reference_assembly",
      "target": "/contract/representation/reference_assembly"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_COORDINATE_SYSTEM_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/coordinate_system",
      "target": "/contract/representation/coordinate_system"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_LIFECYCLE_TIME_UNIT_MISMATCH",
      "severity": "error",
      "source": "/contract/lifecycle/time_unit",
      "target": "/contract/lifecycle/time_unit"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_LIFECYCLE_TEMPORAL_MEANING_MISMATCH",
      "severity": "error",
      "source": "/contract/lifecycle/temporal_meaning",
      "target": "/contract/lifecycle/temporal_meaning"
    },
    {
      "missing": "ignore",
      "operator": "equal",
      "reason_code": "BMCS_ORIGIN_TYPE_MISMATCH",
      "severity": "error",
      "source": "/contract/origin/type",
      "target": "/contract/origin/type"
    },
    {
      "missing": "ignore",
      "operator": "context-compatible",
      "reason_code": "BMCS_BIOLOGICAL_CONTEXT_COMPARTMENT_MISMATCH",
      "severity": "error",
      "source": "/contract/biological_context/compartment",
      "target": "/contract/biological_context/compartment"
    }
  ],
  "compatibility_notes": "Two ports match only when every field the target port requires is satisfied. If required information is missing, the result is UNKNOWN. Any conversion between ports must be a declared, versioned transformation.",
  "description": "Probability Map (Imaging and derived features): what a port must declare, and how two ports are compared.",
  "domain": "imaging",
  "domain_label": "Imaging and derived features",
  "extends": [],
  "fixed": {
    "semantic": {
      "concept": "https://biosimulant.com/standards/model-compatibility/terms/imaging/probability-map"
    }
  },
  "item_packs": [
    "semantic-core",
    "artifact-format",
    "imaging-spatial",
    "biological-context",
    "assay-evidence",
    "uncertainty-quality",
    "provenance-origin",
    "dimensioned-array"
  ],
  "label": "Probability Map",
  "name": "probability-map",
  "profile_id": "imaging/probability-map@0.1",
  "release_eligible": false,
  "requirements": [
    {
      "level": "required",
      "path": "semantic.concept",
      "schema": {
        "const": "https://biosimulant.com/standards/model-compatibility/terms/imaging/probability-map"
      }
    },
    {
      "level": "required",
      "path": "representation.kind",
      "schema": {
        "enum": [
          "dense_vector",
          "sparse_vector",
          "matrix",
          "tensor",
          "array",
          "artifact",
          "file",
          "record",
          "table"
        ]
      }
    },
    {
      "level": "required",
      "path": "dimensions.axes",
      "schema": {
        "items": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "coordinates_ref": {
                  "format": "uri",
                  "type": "string"
                },
                "dynamic": {
                  "type": "boolean"
                },
                "labels_ref": {
                  "format": "uri",
                  "type": "string"
                },
                "labels_sha256": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "meaning": {
                  "minLength": 1,
                  "type": "string"
                },
                "name": {
                  "minLength": 1,
                  "type": "string"
                },
                "ordering": {
                  "minLength": 1,
                  "type": "string"
                },
                "size": {
                  "minimum": 0,
                  "type": "integer"
                },
                "unit": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          ]
        },
        "minItems": 1,
        "type": "array"
      }
    },
    {
      "level": "required",
      "path": "representation.ordering",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "biological_context.species",
      "schema": {
        "anyOf": [
          {
            "const": "any"
          },
          {
            "pattern": "^NCBITaxon:[1-9][0-9]*$"
          }
        ],
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "dimensions.pixel_spacing",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    }
  ],
  "review": {
    "authors": [],
    "decisions": {},
    "domain_owner": null,
    "fixture_review": {},
    "intended_use": null,
    "limitations": [],
    "reviewed_at": null,
    "reviewer": null,
    "schema_reviewer": null,
    "sources": [],
    "status": "candidate"
  },
  "review_questions": [
    "Does the proposed concept identify Probability Map narrowly enough to prevent a different scientific quantity from matching?",
    "Are the allowed representations complete, and can any two allowed representations connect without an explicit adapter?",
    "Which authoritative standards, ontologies, databases or primary publications support each required field and comparison rule?",
    "Which missing value must return UNKNOWN, and which known contradiction must return INCOMPATIBLE?",
    "Should quantity, unit, scale, normalization, baseline or endpoint be required for this profile?",
    "Does this profile need a versioned identifier namespace or an ordered feature universe?",
    "Are axis names, order, labels, coordinates and dynamic-size rules fully specified?",
    "Which species, tissue, cell type, disease, intervention, assay, cohort or compartment fields are required or conditional?",
    "What uses and scientific claims must this profile explicitly exclude?"
  ],
  "scientific_claim": "This profile checks whether two model interfaces fit together. It doesn't show that a model is scientifically valid or clinically safe.",
  "stage": "WAVE_2",
  "technical_pre_review": {
    "checks": [
      "profile-definition-schema",
      "typed-required-values",
      "profile-specific-concept",
      "representation-applicability",
      "stable-field-level-reason-codes",
      "positive-fixture",
      "missing-required-fixture",
      "invalid-value-fixture",
      "direct-compatible-fixture",
      "incompatible-fixture",
      "unknown-fixture",
      "python-typescript-parity"
    ],
    "method_version": "1.0",
    "scientific_signoff_required": true,
    "status": "ready-for-external-review"
  },
  "transformation_policy": {
    "inference": "approval",
    "lossless": "allow",
    "lossy": "approval"
  },
  "version": "0.1.0"
}
