        "items": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "coordinates_ref": {
                  "format": "uri",
                  "type": "string"
                },
                "dynamic": {
                  "type": "boolean"
                },
                "labels_ref": {
                  "format": "uri",
                  "type": "string"
                },
                "labels_sha256": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "meaning": {
                  "minLength": 1,
                  "type": "string"
                },
                "name": {
                  "minLength": 1,
                  "type": "string"
                },
                "ordering": {
                  "minLength": 1,
                  "type": "string"
                },
                "size": {
                  "minimum": 0,
                  "type": "integer"
                },
                "unit": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          ]
        },
        "minItems": 1,
        "type": "array"
      }
    },
    {
      "level": "required",
      "path": "representation.ordering",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "measurement.quantity",
      "schema": {
        "const": "https://biosimulant.com/standards/model-compatibility/quantity-kinds/proportion"
      }
    },
    {
      "level": "required",
      "path": "measurement.unit",
      "schema": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "measurement.scale",
      "schema": {
        "enum": [
          "nominal",
          "ordinal",
          "interval",
          "ratio",
          "proportion",
          "probability",
          "count"
        ]
      }
    },
    {
      "level": "required",
      "path": "biological_context.species",
      "schema": {
        "anyOf": [
          {
            "const": "any"
          },
          {
            "pattern": "^NCBITaxon:[1-9][0-9]*$"
          }
        ],
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "measurement.control",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "measurement.response_direction",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "biological_context.intervention",
      "schema": {
        "items": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "minItems": 1,
        "type": "array"
      }
    },
    {
      "level": "required",
