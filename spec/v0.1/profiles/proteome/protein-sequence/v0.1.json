{
  "$id": "https://biosimulant.com/standards/model-compatibility/profiles/proteome/protein-sequence/v0.1",
  "$schema": "https://biosimulant.com/standards/model-compatibility/v0.1/schemas/profile-definition.schema.json",
  "allowed": {
    "representation": {
      "kind": [
        "scalar",
        "record",
        "table",
        "artifact",
        "file"
      ]
    }
  },
  "applies_to": [
    "scalar",
    "record",
    "artifact"
  ],
  "comparison_rules": [
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_SEMANTIC_CONCEPT_MISMATCH",
      "severity": "error",
      "source": "/contract/semantic/concept",
      "target": "/contract/semantic/concept"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "representation-equivalent",
      "reason_code": "BMCS_REPRESENTATION_KIND_MISMATCH",
      "severity": "error",
      "source": "/contract/representation",
      "target": "/contract/representation"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_ALPHABET_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/alphabet",
      "target": "/contract/representation/alphabet"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_ENCODING_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/encoding",
      "target": "/contract/representation/encoding"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_IDENTIFIERS_NAMESPACE_MISMATCH",
      "severity": "error",
      "source": "/contract/identifiers/namespace",
      "target": "/contract/identifiers/namespace"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "namespace-version-compatible",
      "reason_code": "BMCS_IDENTIFIERS_NAMESPACE_VERSION_MISMATCH",
      "severity": "error",
      "source": "/contract/identifiers/namespace_version",
      "target": "/contract/identifiers/namespace_version"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "context-compatible",
      "reason_code": "BMCS_BIOLOGICAL_CONTEXT_SPECIES_MISMATCH",
      "severity": "error",
      "source": "/contract/biological_context/species",
      "target": "/contract/biological_context/species"
    }
  ],
  "compatibility_notes": "Two ports match only when every field the target requires is satisfied. Missing required information returns UNKNOWN. Every conversion or inference must be declared and versioned.",
  "description": "An amino-acid residue sequence representing a declared protein or polypeptide, with the identifier namespace, namespace version and organism context needed to interpret it.\n",
  "domain": "proteome",
  "domain_label": "Proteome and protein structure",
  "examples": [
    {
      "check": "compare",
      "conditions": "Both ports make the same complete declarations for this profile.",
      "decision": "V0 protein-sequence profile",
      "expect": {
        "status": "EXACT"
      },
      "id": "BMCS-V0-001",
      "report_finding": "Positive baseline",
      "title": "Identical protein-sequence contracts are exact matches",
      "why": "The same complete sequence declaration can connect without conversion or approval."
    },
    {
      "check": "compare",
      "conditions": "Both ports declare different alphabets and no translation step is supplied.",
      "decision": "V0 protein-sequence profile",
      "expect": {
        "status": "INCOMPATIBLE"
      },
      "id": "BMCS-V0-002",
      "report_finding": "Contradictory sequence representation",
      "source_patch": {
        "representation": {
          "alphabet": "amino-acid"
        }
      },
      "target_patch": {
        "representation": {
          "alphabet": "nucleotide"
        }
      },
      "title": "Different sequence alphabets are incompatible",
      "why": "Amino-acid and nucleotide strings do not have the same biological interpretation."
    },
    {
      "check": "compare",
      "conditions": "The source omits the encoding required by the target contract.",
      "decision": "V0 protein-sequence profile",
      "expect": {
        "status": "UNKNOWN"
      },
      "id": "BMCS-V0-003",
      "report_finding": "Missing required representation information",
      "source_remove": [
        "representation.encoding"
      ],
      "title": "Missing sequence encoding is unknown",
      "why": "The sequence cannot be interpreted reliably when its encoding is not declared."
    }
  ],
  "extends": [],
  "field_dispositions": {
    "biological_context.species": {
      "disposition": "required"
    },
    "identifiers.namespace": {
      "disposition": "required"
    },
    "identifiers.namespace_version": {
      "disposition": "required"
    },
    "origin.source_ref": {
      "disposition": "recommended"
    },
    "origin.source_sha256": {
      "disposition": "recommended"
    },
    "representation.alphabet": {
      "disposition": "required"
    },
    "representation.encoding": {
      "disposition": "required"
    },
    "representation.kind": {
      "disposition": "required"
    },
    "semantic.concept": {
      "disposition": "required"
    },
    "semantic.ontology_terms": {
      "disposition": "recommended"
    },
    "semantic.qualifiers": {
      "disposition": "recommended"
    },
    "uncertainty.quality_flags": {
      "disposition": "recommended"
    }
  },
  "fixed": {
    "semantic": {
      "concept": "https://biosimulant.com/standards/model-compatibility/terms/proteome/protein-sequence"
    }
  },
  "intended_use": "Connecting a model output that provides an amino-acid sequence to a model input that consumes a protein or polypeptide sequence.\n",
  "label": "Protein Sequence",
  "limitations": [
    "It does not cover nucleotide sequences or establish that a sequence is scientifically correct.",
    "It does not justify cross-species substitution or an undeclared change of sequence encoding."
  ],
  "name": "protein-sequence",
  "profile_id": "proteome/protein-sequence@0.1",
  "requirements": [
    {
      "level": "required",
      "path": "semantic.concept",
      "schema": {
        "const": "https://biosimulant.com/standards/model-compatibility/terms/proteome/protein-sequence"
      }
    },
    {
      "level": "required",
      "path": "representation.kind",
      "schema": {
        "enum": [
          "scalar",
          "record",
          "table",
          "artifact",
          "file"
        ]
      }
    },
    {
      "level": "required",
      "path": "representation.alphabet",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "representation.encoding",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "identifiers.namespace",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "identifiers.namespace_version",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "biological_context.species",
      "schema": {
        "anyOf": [
          {
            "const": "any"
          },
          {
            "pattern": "^NCBITaxon:[1-9][0-9]*$"
          }
        ],
        "type": "string"
      }
    },
    {
      "level": "recommended",
      "path": "semantic.ontology_terms",
      "schema": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "label": {
              "minLength": 1,
              "type": "string"
            },
            "ontology": {
              "minLength": 1,
              "type": "string"
            },
            "relation": {
              "minLength": 1,
              "type": "string"
            },
            "uri": {
              "format": "uri",
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "uri",
            "ontology",
            "version"
          ],
          "type": "object"
        },
        "minItems": 1,
        "type": "array"
      }
    },
    {
      "level": "recommended",
      "path": "semantic.qualifiers",
      "schema": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      }
    },
    {
      "level": "recommended",
      "path": "origin.source_ref",
      "schema": {
        "format": "uri",
        "type": "string"
      }
    },
    {
      "level": "recommended",
      "path": "origin.source_sha256",
      "schema": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      }
    },
    {
      "level": "recommended",
      "path": "uncertainty.quality_flags",
      "schema": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      }
    }
  ],
  "scientific_claim": "This profile checks whether two model interfaces fit together. It does not show that a model is scientifically valid or clinically safe.",
  "sources": [
    {
      "title": "IUPAC-IUB nomenclature for amino-acid sequences",
      "url": "https://iupac.qmul.ac.uk/AminoAcid/A2021.html"
    },
    {
      "title": "UniProtKB",
      "url": "https://www.uniprot.org/help/uniprotkb"
    },
    {
      "title": "NCBI Taxonomy",
      "url": "https://www.ncbi.nlm.nih.gov/taxonomy"
    }
  ],
  "status": "active",
  "transformation_policy": {
    "inference": "approval",
    "lossless": "allow",
    "lossy": "approval"
  },
  "version": "0.1.0"
}
