{
  "$id": "https://biosimulant.com/standards/model-compatibility/profiles/proteome/protein-structure/v0.1",
  "$schema": "https://biosimulant.com/standards/model-compatibility/v0.1/schemas/profile-definition.schema.json",
  "allowed": {
    "representation": {
      "kind": [
        "record",
        "table",
        "artifact",
        "file"
      ]
    }
  },
  "applies_to": [
    "record",
    "artifact"
  ],
  "comparison_rules": [
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_SEMANTIC_CONCEPT_MISMATCH",
      "severity": "error",
      "source": "/contract/semantic/concept",
      "target": "/contract/semantic/concept"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "representation-equivalent",
      "reason_code": "BMCS_REPRESENTATION_KIND_MISMATCH",
      "severity": "error",
      "source": "/contract/representation",
      "target": "/contract/representation"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_STRUCTURE_FORMAT_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/structure_format",
      "target": "/contract/representation/structure_format"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_REPRESENTATION_COORDINATE_SYSTEM_MISMATCH",
      "severity": "error",
      "source": "/contract/representation/coordinate_system",
      "target": "/contract/representation/coordinate_system"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_IDENTIFIERS_NAMESPACE_MISMATCH",
      "severity": "error",
      "source": "/contract/identifiers/namespace",
      "target": "/contract/identifiers/namespace"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "namespace-version-compatible",
      "reason_code": "BMCS_IDENTIFIERS_NAMESPACE_VERSION_MISMATCH",
      "severity": "error",
      "source": "/contract/identifiers/namespace_version",
      "target": "/contract/identifiers/namespace_version"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "context-compatible",
      "reason_code": "BMCS_BIOLOGICAL_CONTEXT_SPECIES_MISMATCH",
      "severity": "error",
      "source": "/contract/biological_context/species",
      "target": "/contract/biological_context/species"
    },
    {
      "layer": "technical",
      "missing": "unknown",
      "operator": "equal",
      "reason_code": "BMCS_ORIGIN_TYPE_MISMATCH",
      "severity": "error",
      "source": "/contract/origin/type",
      "target": "/contract/origin/type"
    }
  ],
  "compatibility_notes": "Two ports match only when every field the target requires is satisfied. Missing required information returns UNKNOWN. Every conversion or inference must be declared and versioned.",
  "description": "A three-dimensional structural representation of a declared protein or protein-containing assembly, including the identity, coordinate representation and format needed to interpret the structure.\n",
  "domain": "proteome",
  "domain_label": "Proteome and protein structure",
  "examples": [
    {
      "check": "compare",
      "conditions": "Both ports declare different coordinate systems and no conversion is supplied.",
      "decision": "V0 protein-structure profile",
      "expect": {
        "status": "INCOMPATIBLE"
      },
      "id": "BMCS-V0-006",
      "report_finding": "Contradictory coordinate representation",
      "source_patch": {
        "representation": {
          "coordinate_system": "cartesian-angstrom"
        }
      },
      "target_patch": {
        "representation": {
          "coordinate_system": "fractional-unit-cell"
        }
      },
      "title": "Different coordinate systems are incompatible",
      "why": "Coordinates in different systems cannot be consumed as if their numerical values have the same spatial meaning."
    },
    {
      "check": "compare",
      "conditions": "The source omits the structure origin required by the target contract.",
      "decision": "V0 protein-structure profile",
      "expect": {
        "status": "UNKNOWN"
      },
      "id": "BMCS-V0-007",
      "report_finding": "Missing structure provenance",
      "source_remove": [
        "origin.type"
      ],
      "title": "Missing structure origin is unknown",
      "why": "Experimental, predicted and otherwise derived structures have different provenance and limitations."
    },
    {
      "check": "compare",
      "conditions": "Both ports make the same complete declarations for this profile.",
      "decision": "V0 protein-structure profile",
      "expect": {
        "status": "EXACT"
      },
      "id": "BMCS-V0-009",
      "report_finding": "Positive baseline",
      "title": "Identical protein-structure contracts are exact matches",
      "why": "The same complete structure declaration can connect without conversion or approval."
    }
  ],
