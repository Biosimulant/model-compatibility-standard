  "intended_use": "Connecting a model output that provides a three-dimensional protein structure to a model input that consumes the same declared structural representation.\n",
  "label": "Protein Structure",
  "limitations": [
    "It does not establish structural accuracy, biological function or fitness for a downstream claim.",
    "A predicted structure is not treated as interchangeable with an experimental structure unless the target permits that origin."
  ],
  "name": "protein-structure",
  "profile_id": "proteome/protein-structure@0.1",
