  "proposed_requirements": [
    {
      "level": "required",
      "path": "semantic.concept",
      "schema": {
        "const": "https://biosimulant.com/standards/model-compatibility/terms/proteome/protein-structure"
      }
    },
    {
      "level": "required",
      "path": "representation.kind",
      "schema": {
        "enum": [
          "record",
          "table",
          "artifact",
          "file"
        ]
      }
    },
    {
      "level": "required",
      "path": "representation.structure_format",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "representation.coordinate_system",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "identifiers.namespace",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "identifiers.namespace_version",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "biological_context.species",
      "schema": {
        "anyOf": [
          {
            "const": "any"
          },
          {
            "pattern": "^NCBITaxon:[1-9][0-9]*$"
          }
        ],
        "type": "string"
      }
    },
    {
      "level": "required",
      "path": "origin.type",
      "schema": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    }
  ],
  "questions_for_reviewers": [
    "Does the proposed concept define Protein Structure precisely enough for the stated use, without including scientifically different data?",
    "Are the proposed required fields sufficient, and is each field correctly classified as required rather than conditional or optional?",
    "For every candidate field listed in this packet, should it be required, conditional, recommended or excluded for this profile?",
    "Are the allowed representations scientifically interchangeable, or does any pair require an explicit, versioned transformation?",
    "Which authoritative standards, ontologies, databases or primary publications support each required field and comparison rule?",
    "Which missing value must return UNKNOWN, and which known contradiction must return INCOMPATIBLE?",
    "Do the worked fixtures cover the important direct matches, contradictions, missing information and permitted transformations?",
    "What uses and scientific claims must this profile explicitly exclude?",
    "Which identifier namespaces and releases are permitted, and when is a pinned mapping required between them?",
    "When must organism identity match exactly, and are any cross-species connections scientifically defensible?",
    "Which provenance and file-format details are necessary to interpret the data safely, and which are merely useful metadata?"
  ],
  "required_external_approvals": [
    "named domain-qualified scientific reviewer",
    "different named schema and compatibility reviewer",
    "domain owner"
  ],
  "scientific_examples": [
    {
      "check": "compare",
      "conditions": "Both ports declare different coordinate systems and no conversion is supplied.",
      "decision": "V0 protein-structure draft",
      "expect": {
        "status": "INCOMPATIBLE"
      },
      "id": "BMCS-V0-006",
      "report_finding": "Contradictory coordinate representation",
      "source_patch": {
        "representation": {
          "coordinate_system": "cartesian-angstrom"
        }
      },
      "target_patch": {
        "representation": {
          "coordinate_system": "fractional-unit-cell"
        }
      },
      "title": "Different coordinate systems are incompatible",
      "why": "Coordinates in different systems cannot be consumed as if their numerical values have the same spatial meaning."
    },
    {
      "check": "compare",
      "conditions": "The source omits the structure origin required by the target contract.",
      "decision": "V0 protein-structure draft",
      "expect": {
        "status": "UNKNOWN"
      },
      "id": "BMCS-V0-007",
      "report_finding": "Missing structure provenance",
      "source_remove": [
        "origin.type"
      ],
      "title": "Missing structure origin is unknown",
      "why": "Experimental, predicted and otherwise derived structures have different provenance and limitations."
    },
    {
      "check": "compare",
      "conditions": "Both ports make the same complete declarations for this profile.",
      "decision": "V0 protein-structure draft",
      "expect": {
        "status": "EXACT"
      },
      "id": "BMCS-V0-009",
      "report_finding": "Positive baseline",
      "title": "Identical protein-structure contracts are exact matches",
      "why": "The same complete structure declaration can connect without conversion or approval."
    }
  ],
