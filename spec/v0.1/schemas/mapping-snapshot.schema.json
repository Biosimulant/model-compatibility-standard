{
  "$id": "https://biosimulant.com/standards/model-compatibility/v0.1/schemas/mapping-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "license": {
      "minLength": 1,
      "type": "string"
    },
    "mappings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "source": {
            "minLength": 1,
            "type": "string"
          },
          "target": {
            "minLength": 1,
            "type": "string"
          },
          "targets": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ref": {
      "format": "uri",
      "type": "string"
    },
    "release": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "0.1"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "source_namespace": {
      "minLength": 1,
      "type": "string"
    },
    "target_namespace": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "ref",
    "sha256"
  ],
  "title": "Mapping Snapshot",
  "type": "object"
}
