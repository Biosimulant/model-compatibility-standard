{
  "$id": "https://biosimulant.com/standards/model-compatibility/v0.1/schemas/ontology-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "equivalences": {
      "items": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "minItems": 2,
        "type": "array"
      },
      "type": "array"
    },
    "license": {
      "minLength": 1,
      "type": "string"
    },
    "ontology": {
      "minLength": 1,
      "type": "string"
    },
    "ref": {
      "format": "uri",
      "type": "string"
    },
    "release": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "0.1"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "subsumptions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "child": {
            "minLength": 1,
            "type": "string"
          },
          "parent": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "parent",
          "child"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "ref",
    "sha256"
  ],
  "title": "Ontology Snapshot",
  "type": "object"
}
